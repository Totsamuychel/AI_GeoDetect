# =============================================================================
# .gitignore for geo-photo-ukraine diploma project
# =============================================================================

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env
.conda/

# ── Data & Large Files (IMPORTANT) ───────────────────────────────────────────
# Ignore ALL images in any data-related directory
**/images/**/*.jpg
**/images/**/*.jpeg
**/images/**/*.png
**/*.zip

# Specifically ignore raw and processed data images
data/raw/images/
data/processed/images/
dataset/raw/images/
dataset/raw/osv5m/images/
dataset/processed/images/

# manifests are small CSV files — tracked in git

# Cache
.cache/
data/.cache/

# Keep manifest files
!data/dataset_manifest_example.csv
!dataset/raw/osv5m/manifest.csv
!data/osv5m/manifest.csv

# ── Model checkpoints and weights ─────────────────────────────────────────────
results/checkpoints/
*.pth
*.pt
*.ckpt

# ── Logs & Temporary ──────────────────────────────────────────────────────────
results/logs/
wandb/
mlruns/
*.log
tmp/
temp/

# ── RunPod upload artifacts ──────────────────────────────────────────────────
diploma_dataset.tar.gz
diploma_code.zip
runpod_upload/

# ── Preprocessed (resized) images — regenerable via preprocess_resize.py ─────
dataset_fast/

# ── Training logs & temp samples (transient) ─────────────────────────────────
logs/
cache/

# ── Auto-generated per-source manifests (regenerable from raw images) ────────
dataset/raw/mapillary/manifest.csv
dataset/raw/mapillary/*/manifest.csv
dataset/raw/global_streetscapes/manifest.csv
dataset/raw/osv5m/filtered_cities.parquet

# ── IDE / local ──────────────────────────────────────────────────────────────
.claude/settings.local.json
.vscode/

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
